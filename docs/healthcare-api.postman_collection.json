                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"date_of_birth\": \"1990-05-14\",\n  \"gender\": \"male\",\n  \"phone\": \"+919876543210\",\n  \"email\": \"ravi@example.com\",\n  \"address\": \"Ghaziabad, UP\",\n  \"medical_history\": \"Mild asthma\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.id) pm.collectionVariables.set('patientId', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/",
